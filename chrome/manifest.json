{
  "manifest_version": 3,
  "name": "AURA Download Manager",
  "version": "0.5.0",
  "description": "Explicitly hand off downloads to your AURA desktop app.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:18763/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "AURA Download Manager",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}