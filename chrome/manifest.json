{
  "manifest_version": 3,
  "name": "AURA Download Manager",
  "version": "0.6.3",
  "description": "Explicitly hand off downloads to your AURA desktop app.",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "AURA Download Manager",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
