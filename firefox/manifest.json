{
  "manifest_version": 2,
  "name": "AURA Download Manager",
  "version": "0.6.4",
  "description": "Automatically capture downloads with AURA; leave images in your browser and keep manual right-click handoff.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "storage"
  ],
  "background": {
    "scripts": [
      "capture.js",
      "worker.js"
    ]
  },
  "browser_action": {
    "default_title": "AURA Download Manager",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aura-download-manager@local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
