{
  "manifest_version": 2,
  "name": "AURA Download Manager",
  "version": "0.4.1",
  "permissions": [
    "http://127.0.0.1:18763/*",
    "http://*/*",
    "contextMenus",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "worker.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aura-download-manager@local"
    }
  },
  "description": "Direct media and non-DRM HLS/DASH manifest detection for AURA",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
